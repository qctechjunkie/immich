# Immich Configuration
# Copy this file to .env and update with your values.
# Full reference: https://docs.immich.app/install/environment-variables

# Volume Paths
# Update these paths to match your system's directory structure
# Linux/Mac example: /home/username/Docker/immich/work
# Windows example: C:/Users/username/Docker/immich/work
DOCKER_DATA_PATH=/path/to/your/immich

# Timezone (find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Chicago

# The Immich version to use. "v3" tracks the latest v3.x release (upstream default).
# You can pin more strictly to a specific version like "v3.0.1" if you want zero surprises.
# Avoid "release" — it would auto-jump to a future v4 with breaking changes.
IMMICH_VERSION=v3

# Connection secret for postgres. Change it to a random password.
# Use only the characters A-Za-z0-9, without special characters or spaces.
DB_PASSWORD=changeme_secure_password

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
